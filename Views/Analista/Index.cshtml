@model List<SolicitudCredito>
@{
    ViewData["Title"] = "Panel del Analista";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h2 mb-1">Panel del Analista</h1>
            <p class="text-body-secondary mb-0">Solicitudes de crédito pendientes de revisión.</p>
        </div>
    </div>

    @if (TempData["Exito"] is string mensajeExito && !string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert-success" role="alert">
            @mensajeExito
        </div>
    }

    @if (TempData["Error"] is string mensajeError && !string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @mensajeError
        </div>
    }

    <section class="card">
        <div class="card-body">
            <h2 class="h5 card-title mb-3">Solicitudes pendientes</h2>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0" role="alert">
                    No hay solicitudes pendientes para revisar.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Id</th>
                                <th scope="col">Cliente</th>
                                <th scope="col">Ingresos Mensuales del Cliente</th>
                                <th scope="col">Monto Solicitado</th>
                                <th scope="col">Fecha</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var solicitud in Model)
                            {
                                var nombreCliente = solicitud.Cliente.Usuario?.Email
                                    ?? solicitud.Cliente.Usuario?.UserName
                                    ?? solicitud.Cliente.UsuarioId;

                                <tr>
                                    <td>@solicitud.Id</td>
                                    <td>@nombreCliente</td>
                                    <td>@solicitud.Cliente.IngresosMensuales.ToString("C2")</td>
                                    <td>@solicitud.MontoSolicitado.ToString("C2")</td>
                                    <td>@solicitud.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <form asp-controller="Analista" asp-action="Aprobar" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@solicitud.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    Aprobar
                                                </button>
                                            </form>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rechazar-solicitud-@solicitud.Id">
                                                Rechazar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

@if (Model.Count > 0)
{
    @foreach (var solicitud in Model)
    {
        var modalId = $"rechazar-solicitud-{solicitud.Id}";
        var modalLabelId = $"{modalId}-label";
        var motivoId = $"{modalId}-motivo";

        <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@modalLabelId" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@modalLabelId">Rechazar solicitud #@solicitud.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form asp-controller="Analista" asp-action="Rechazar" method="post">
                        <div class="modal-body">
                            <input type="hidden" name="id" value="@solicitud.Id" />
                            <label for="@motivoId" class="form-label">Motivo del rechazo</label>
                            <textarea class="form-control"
                                      id="@motivoId"
                                      name="motivoRechazo"
                                      rows="3"
                                      required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-danger">Confirmar rechazo</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@model IReadOnlyList<Notificacion>
@{
    ViewData["Title"] = "Mis Notificaciones";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h2 mb-1">Mis Notificaciones</h1>
            <p class="text-body-secondary mb-0">Avisos sobre tus solicitudes de crédito.</p>
        </div>
        <a asp-controller="Solicitudes" asp-action="Index" class="btn btn-outline-secondary">
            Volver a Mis Solicitudes
        </a>
    </div>

    <section class="card">
        <div class="card-body">
            <h2 class="h5 card-title mb-3">Notificaciones recibidas</h2>

            @if (Model.Count == 0)
            {
                <div class="alert alert-info mb-0" role="alert">
                    Todavía no tienes notificaciones.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Fecha</th>
                                <th scope="col">Solicitud</th>
                                <th scope="col">Notificación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var notificacion in Model)
                            {
                                <tr>
                                    <td class="text-nowrap">@notificacion.FechaProcesamientoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>#@notificacion.SolicitudId</td>
                                    <td>@notificacion.Texto</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
